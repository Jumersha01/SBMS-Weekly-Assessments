<?xml version="1.0" encoding="UTF-8"?>

<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
       http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans.xsd">
       
       <bean id="cor" class="com.nt.sbeans.Course">
        <property name="courseId" value="101"></property>
        <property name="courseName" value="Java FullStack"></property>
         
       </bean>
       <bean id="fac" class="com.nt.sbeans.Facutly">
       
        <constructor-arg ref="cor"></constructor-arg>
        <property name="facultyId" value="202"></property>
        <property name="name" value="RaviShankar"></property>
        
       </bean>
       
       </beans>

