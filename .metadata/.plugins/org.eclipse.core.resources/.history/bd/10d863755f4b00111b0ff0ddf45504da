package com.nt.sbeans;

import java.util.Map;

import org.jspecify.annotations.Nullable;
import org.springframework.beans.factory.FactoryBean;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.stereotype.Component;

import com.nt.comp.Vehicle;

public class VehiclFactory implements FactoryBean<Vehicle> {
	
	@Component
	public class Vehiclee {
	   
	@Autowired
	Map<String,Vehicle> vehicle;

	@Value("truck")
	String type;

	@Override
	public @Nullable Vehicle getObject() throws Exception {
		Vehicle vehi  = vehicle.get(type);
		return vehi;
	}

	@Override
	public @Nullable Class<?> getObjectType() {
		// TODO Auto-generated method stub
		return null;
	}

}
